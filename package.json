{
  "name": "truecloud",
  "version": "1.274.0",
  "private": true,
  "scripts": {
    "dev": "bun server.js",
    "build": "next build",
    "start": "bun server.js",
    "lint": "eslint",
    "restart": "systemctl restart truecloud",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "setup": "bun run db:generate && bun run db:push",
    "create-admin": "bun scripts/create-admin.js",
    "generate-secret": "bun scripts/generate-secret.js",
    "pull": "git pull",
    "stopServ": "systemctl stop truecloud",
    "runUpdate": "bun run pull && bun install && bun run db:push && bun run db:migrate && bun run build && bun run restart",
    "bump-version": "bun run --bun npm version minor --no-git-tag-version && git add package.json && git commit -m 'chore: bump minor version'",
    "module:add": "bun scripts/module-manager.js add",
    "module:remove": "bun scripts/module-manager.js remove",
    "module:list": "bun scripts/module-manager.js list"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/react-query": "^5.90.21",
    "archiver": "^7.0.1",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "date-fns": "^4.1.0",
    "hls.js": "^1.6.15",
    "mime-types": "^3.0.2",
    "next": "16.2.6",
    "next-auth": "5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.6.0",
    "react-redux": "^9.2.0",
    "react-virtualized": "^9.22.6",
    "react-zoom-pan-pinch": "^3.7.0",
    "sharp": "^0.34.5",
    "three": "^0.182.0",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "25.0.8",
    "@types/react": "19.2.8",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.2.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.2.1"
  },
  "packageManager": "bun@1.2.4",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
