{
  "name": "truecloud",
  "version": "1.208.0",
  "private": true,
  "scripts": {
    "dev": "bun server.js",
    "build": "next build --turbopack",
    "start": "bun server.js",
    "lint": "eslint",
    "restart": "systemctl restart truecloud",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "setup": "bun run db:generate && bun run db:push",
    "create-admin": "bun scripts/create-admin.js",
    "generate-secret": "bun scripts/generate-secret.js",
    "pull": "git pull",
    "stopServ": "systemctl stop truecloud",
    "runUpdate": "bun run pull && bun install && sed -i 's|require(\"../../../build/Release/node_datachannel.node\")|require(require(\"path\").join(process.cwd(),\"node_modules/node-datachannel/build/Release/node_datachannel.node\"))|g' node_modules/node-datachannel/dist/cjs/lib/node-datachannel.cjs && bun run db:push && bun run build && bun run restart",
    "bump-version": "bun run --bun npm version minor --no-git-tag-version && git add package.json && git commit -m 'chore: bump minor version'",
    "rebuild-native": "SHARP_FORCE_GLOBAL_LIBVIPS= bun pm trust --all || true"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@reduxjs/toolkit": "^2.0.0",
    "@tanstack/react-query": "^5.90.18",
    "archiver": "^7.0.1",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "date-fns": "^4.1.0",
    "hls.js": "^1.6.15",
    "mime-types": "^3.0.2",
    "next": "16.1.2",
    "next-auth": "5.0.0-beta.30",
    "node-addon-api": "^8.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.3.0",
    "react-redux": "^9.0.0",
    "react-virtualized": "^9.22.6",
    "react-zoom-pan-pinch": "^3.7.0",
    "sharp": "^0.34.5",
    "three": "^0.182.0",
    "webtorrent": "^2.8.5",
    "ws": "^8.19.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "25.0.8",
    "@types/react": "19.2.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.2",
    "prisma": "^5.22.0",
    "tailwindcss": "^4"
  },
  "packageManager": "bun@1.2.4",
  "trustedDependencies": [
    "node-datachannel",
    "unrs-resolver",
    "utp-native",
    "sharp"
  ]
}
