// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    String   @id @default(cuid())
  email                 String   @unique
  username              String   @unique
  password              String
  name                  String?
  role                  String   @default("user") // user, admin
  hasRootAccess         Boolean  @default(false) // Allow access to root/all files or only personal folder
  sessionLockEnabled    Boolean  @default(false)
  sessionLockPin        String?  // bcrypt-hashed 4-digit PIN
  sessionLockTimeout    Int      @default(15) // minutes
  isSessionLocked       Boolean  @default(false) // Manually locked via "Lock Now"
  lastActivityAt        DateTime @default(now())
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  files       File[]
  permissions FilePermission[]
  sessions    Session[]
  shares      Share[]
  favorites   Favorite[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model File {
  id          String   @id @default(cuid())
  name        String
  path        String
  size        BigInt
  mimeType    String
  isDirectory Boolean  @default(false)
  parentId    String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation(fields: [ownerId], references: [id])
  permissions FilePermission[]

  @@index([parentId])
  @@index([ownerId])
}

model FilePermission {
  id         String   @id @default(cuid())
  fileId     String
  userId     String
  canRead    Boolean  @default(false)
  canWrite   Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canShare   Boolean  @default(false)
  createdAt  DateTime @default(now())

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([fileId, userId])
}

model Share {
  id           String    @id @default(cuid())
  token        String    @unique @default(cuid())
  path         String    // File/folder path relative to uploads
  fileName     String    // Original file/folder name
  isDirectory  Boolean   @default(false)
  ownerId      String
  passwordHash String?   // Optional bcrypt hash
  expiresAt    DateTime?
  allowUploads Boolean   @default(false) // Allow public uploads to this share
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  accessCount  Int       @default(0)

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([ownerId])
  @@index([path, fileName])
}

model Favorite {
  id          String   @id @default(cuid())
  path        String   // Full path to file/folder
  name        String   // Display name
  isDirectory Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([path, ownerId])
  @@index([ownerId])
}

model FileIndex {
  id           String   @id @default(cuid())
  name         String
  path         String   @unique // relative to UPLOAD_DIR, e.g. "user_abc/docs/file.pdf"
  parentPath   String   // relative parent dir, e.g. "user_abc/docs"
  extension    String   // lowercase, e.g. "pdf", "" for dirs/no-ext
  size         BigInt   @default(0)
  isDirectory  Boolean  @default(false)
  lastModified DateTime @default(now())
  ownerId      String?  // null = shared folder; set for user_ folders
  indexedAt    DateTime @default(now()) @updatedAt

  @@index([name])
  @@index([ownerId])
  @@index([isDirectory])
}

model SmbShare {
  id         String   @id @default(cuid())
  name       String   @unique   // becomes [share_name] in smb.conf
  path       String             // relative to UPLOAD_DIR (e.g. "" for root, "user_xxx" for user folder)
  comment    String?
  readOnly   Boolean  @default(false)
  browsable  Boolean  @default(true)
  guestOk    Boolean  @default(false)
  validUsers String   @default("[]") // JSON array of usernames (empty = all users)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model MinecraftServer {
  id           String   @id @default(cuid())
  name         String   @unique        // also used as directory name
  port         Int      @default(25565)
  maxRam       Int      @default(2048) // MB
  minRam       Int      @default(512)  // MB
  autoStart    Boolean  @default(false)
  directory    String                  // absolute path e.g. /opt/minecraft-servers/<name>
  paperVersion String   @default("latest") // PaperMC build version
  status       String   @default("stopped") // stopped | starting | running | stopping
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
